{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.saurabhrb/dataverse-test",
  "title": "Microsoft Dataverse (staging test)",
  "description": "Query, create, and manage Microsoft Dataverse tables, records, and solutions from AI agents.",
  "version": "1.0.82",
  "websiteUrl": "https://learn.microsoft.com/power-apps/maker/data-platform/data-platform-mcp",
  "repository": {
    "url": "https://github.com/saurabhrb/Dataverse-skills-SaurabhRB-fork",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@microsoft/dataverse",
      "version": "1.0.82",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the Dataverse CLI as an MCP server"
        },
        {
          "type": "positional",
          "valueHint": "environment_url",
          "description": "Dataverse environment URL, e.g. https://yourorg.crm.dynamics.com",
          "isRequired": true,
          "format": "string"
        }
      ]
    }
  ]
}
